<% servings_label = @servings == 1 ? t('shopping_lists.show.person_singular') : t('shopping_lists.show.person_plural') %>

<div class="shopping-workspace" data-week-key="<%= @week_key %>" data-servings="<%= @servings %>" data-servings-label="<%= servings_label %>">
  <div class="card shopping-hero-card">
    <div class="shopping-hero-top">
      <h1 class="section-title shopping-page-title"><%= t('shopping_lists.show.title') %></h1>
      <div class="servings-stepper" role="group" aria-label="<%= t('shopping_lists.show.title') %>">
        <% if @servings > 1 %>
          <a href="<%= shopping_list_path(servings: @servings - 1) %>" class="stepper-btn" aria-label="<%= t('shopping_lists.show.decrease_servings') %>">−</a>
        <% else %>
          <span class="stepper-btn stepper-btn-disabled" aria-disabled="true">−</span>
        <% end %>
        <span class="stepper-value">👥 <%= @servings %> <%= servings_label %></span>
        <% if @servings < ShoppingListGenerator::MAX_SERVINGS %>
          <a href="<%= shopping_list_path(servings: @servings + 1) %>" class="stepper-btn" aria-label="<%= t('shopping_lists.show.increase_servings') %>">+</a>
        <% else %>
          <span class="stepper-btn stepper-btn-disabled" aria-disabled="true">+</span>
        <% end %>
      </div>
    </div>

    <% if @total_count > 0 %>
      <div class="shopping-progress-wrap">
        <div class="shopping-progress-meta">
          <span id="shopping-progress-label"><%= t('shopping_lists.show.progress_label', done: 0, total: @total_count) %></span>
          <span id="shopping-progress-pct">0%</span>
        </div>
        <div class="shopping-progress-track">
          <div class="shopping-progress-fill" id="shopping-progress-fill" style="width: 0%;"></div>
        </div>
      </div>
    <% end %>

    <div class="shopping-seg-tabs" role="tablist">
      <button type="button" class="shopping-seg-tab active" data-tab="fresh" role="tab" aria-selected="true">
        <%= t('shopping_lists.show.tab_fresh') %> (<span id="count-fresh"><%= @fresh_count %></span>)
      </button>
      <button type="button" class="shopping-seg-tab" data-tab="pantry" role="tab" aria-selected="false">
        <%= t('shopping_lists.show.tab_pantry') %> (<span id="count-pantry"><%= @pantry_count %></span>)
      </button>
      <button type="button" class="shopping-seg-tab" data-tab="extras" role="tab" aria-selected="false">
        <%= t('shopping_lists.show.tab_extras') %> (<span id="count-extras">0</span>)
      </button>
    </div>

    <div class="shopping-wa-preview" id="shopping-wa-preview" hidden></div>
  </div>

  <!-- Fresh Weekly Stops Panel -->
  <section class="shopping-tab-panel" id="panel-fresh" data-panel="fresh">
    <% if @total_count.zero? %>
      <div class="card shopping-empty-card">
        <h3><%= t('shopping_lists.show.empty_title') %></h3>
        <p><%= t('shopping_lists.show.empty_subtitle') %></p>
        <a href="<%= root_path %>" class="btn-action"><%= t('shopping_lists.show.go_to_calendar') %></a>
      </div>
    <% elsif @fresh_sections.empty? %>
      <div class="card shopping-empty-card">
        <p><%= t('shopping_lists.show.fresh_empty') %></p>
      </div>
    <% else %>
      <div class="shopping-sections-grid">
        <% @fresh_sections.each do |section, items| %>
          <div class="card shopping-section-card" data-section="<%= section %>" data-emoji="<%= shopping_section_emoji(section) %>" data-group="fresh">
            <div class="shopping-section-head">
              <span class="shopping-section-name"><%= shopping_section_emoji(section) %> <%= section %></span>
              <button type="button" class="btn-copy-section" data-copy-section="<%= section %>">
                <%= t('shopping_lists.show.copy_section') %>
              </button>
            </div>
            <div class="shopping-section-items">
              <% items.each do |item| %>
                <% item_key = "ing-#{item[:ingredient].id}" %>
                <div class="shopping-check-row"
                     role="checkbox"
                     tabindex="0"
                     aria-checked="false"
                     data-item-key="<%= item_key %>"
                     data-item-group="fresh"
                     data-item-section="<%= section %>"
                     data-item-emoji="<%= shopping_section_emoji(section) %>"
                     data-item-name="<%= item[:ingredient].name %>"
                     data-item-qty="<%= item[:quantity] %>">
                  <span class="shopping-check-box" aria-hidden="true"></span>
                  <div class="shopping-item-main">
                    <span class="shopping-item-title"><%= item[:ingredient].name %></span>
                    <% if item[:dishes].size <= 2 %>
                      <span class="shopping-item-usage"><%= format_dish_usage(item[:dishes]) %></span>
                    <% else %>
                      <button type="button" class="shopping-usage-toggle" aria-expanded="false">
                        <%= t('shopping_lists.show.used_in_meals', count: total_dish_occurrences(item[:dishes])) %> ▾
                      </button>
                      <ul class="shopping-usage-list" hidden>
                        <% item[:dishes].each do |entry| %>
                          <li><%= format_single_dish_usage(entry) %></li>
                        <% end %>
                      </ul>
                    <% end %>
                  </div>
                  <span class="shopping-qty-pill"><%= item[:quantity] %></span>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>

  <!-- Pantry Staples Panel -->
  <section class="shopping-tab-panel" id="panel-pantry" data-panel="pantry" hidden>
    <% if @pantry_sections.empty? %>
      <div class="card shopping-empty-card">
        <p><%= t('shopping_lists.show.pantry_empty') %></p>
      </div>
    <% else %>
      <p class="shopping-pantry-hint"><%= t('shopping_lists.show.pantry_hint') %></p>
      <div class="shopping-sections-grid">
        <% @pantry_sections.each do |section, items| %>
          <div class="card shopping-section-card" data-section="<%= section %>" data-emoji="<%= shopping_section_emoji(section) %>" data-group="pantry">
            <div class="shopping-section-head">
              <span class="shopping-section-name"><%= shopping_section_emoji(section) %> <%= section %></span>
              <button type="button" class="btn-copy-section" data-copy-section="<%= section %>">
                <%= t('shopping_lists.show.copy_section') %>
              </button>
            </div>
            <div class="shopping-section-items">
              <% items.each do |item| %>
                <% item_key = "ing-#{item[:ingredient].id}" %>
                <div class="shopping-check-row"
                     role="checkbox"
                     tabindex="0"
                     aria-checked="false"
                     data-item-key="<%= item_key %>"
                     data-item-group="pantry"
                     data-item-section="<%= section %>"
                     data-item-emoji="<%= shopping_section_emoji(section) %>"
                     data-item-name="<%= item[:ingredient].name %>"
                     data-item-qty="<%= item[:quantity] %>">
                  <span class="shopping-check-box" aria-hidden="true"></span>
                  <div class="shopping-item-main">
                    <span class="shopping-item-title"><%= item[:ingredient].name %></span>
                    <% if item[:dishes].size <= 2 %>
                      <span class="shopping-item-usage"><%= format_dish_usage(item[:dishes]) %></span>
                    <% else %>
                      <button type="button" class="shopping-usage-toggle" aria-expanded="false">
                        <%= t('shopping_lists.show.used_in_meals', count: total_dish_occurrences(item[:dishes])) %> ▾
                      </button>
                      <ul class="shopping-usage-list" hidden>
                        <% item[:dishes].each do |entry| %>
                          <li><%= format_single_dish_usage(entry) %></li>
                        <% end %>
                      </ul>
                    <% end %>
                  </div>
                  <span class="shopping-qty-pill"><%= item[:quantity] %></span>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>

  <!-- Quick Extras Panel (Offline localStorage-backed) -->
  <section class="shopping-tab-panel" id="panel-extras" data-panel="extras" hidden>
    <div class="card shopping-extras-card">
      <form id="shopping-extras-form" class="shopping-extras-form">
        <input type="text"
               id="shopping-extra-input"
               class="form-input shopping-extra-input"
               placeholder="<%= t('shopping_lists.show.extras_placeholder') %>"
               autocomplete="off">
        <button type="submit" class="btn-action shopping-extra-submit"><%= t('shopping_lists.show.extras_add') %></button>
      </form>
      <div id="shopping-extras-list"></div>
      <p id="shopping-extras-empty" class="shopping-extras-empty"><%= t('shopping_lists.show.extras_empty') %></p>
    </div>
  </section>
</div>

<!-- Sticky Bottom Action Dock -->
<div class="shopping-bottom-dock">
  <div class="shopping-dock-inner">
    <button type="button" id="btn-copy-whatsapp" class="btn-whatsapp-primary">
      <%= t('shopping_lists.show.copy_whatsapp') %>
    </button>
    <button type="button" id="btn-clear-checked" class="btn-dock-clear">
      <%= t('shopping_lists.show.clear_checked') %>
    </button>
  </div>
</div>

<div class="shopping-toast" id="shopping-toast" role="status" aria-live="polite"></div>

<script>
  (function() {
    const workspace = document.querySelector(".shopping-workspace");
    if (!workspace) return;

    const weekKey = workspace.dataset.weekKey || "current";
    const servings = workspace.dataset.servings || "2";
    const servingsLabel = workspace.dataset.servingsLabel || "";
    const checkedStorageKey = "dailymeals_checked_" + weekKey;
    const extrasStorageKey = "dailymeals_extras_" + weekKey;

    const I18N = {
      progressTemplate: "<%= j t('shopping_lists.show.progress_label', done: '__DONE__', total: '__TOTAL__') %>",
      allDone: "<%= j t('shopping_lists.show.all_done') %>",
      copiedToast: "<%= j t('shopping_lists.show.copied_toast') %>",
      copiedSectionTemplate: "<%= j t('shopping_lists.show.copied_section_toast', section: '__SECTION__') %>",
      nothingToCopy: "<%= j t('shopping_lists.show.nothing_to_copy') %>",
      whatsappHeader: "<%= j t('shopping_lists.show.whatsapp_header', servings: @servings, label: servings_label) %>",
      whatsappSectionTemplate: "<%= j t('shopping_lists.show.whatsapp_section_header', emoji: '__EMOJI__', section: '__SECTION__', servings: @servings, label: servings_label) %>",
      whatsappExtrasHeader: "<%= j t('shopping_lists.show.whatsapp_extras_header') %>",
      extrasRemove: "<%= j t('shopping_lists.show.extras_remove') %>"
    };

    function loadJSON(key, fallback) {
      try {
        const raw = window.localStorage.getItem(key);
        return raw ? JSON.parse(raw) : fallback;
      } catch (e) {
        return fallback;
      }
    }

    function saveJSON(key, value) {
      try {
        window.localStorage.setItem(key, JSON.stringify(value));
      } catch (e) {
        // Ignore storage quota / private mode errors
      }
    }

    let checkedMap = loadJSON(checkedStorageKey, {});
    let extrasList = loadJSON(extrasStorageKey, []);
    let toastTimer = null;

    const itemRows = Array.from(document.querySelectorAll(".shopping-check-row[data-item-key]"));
    const tabButtons = Array.from(document.querySelectorAll(".shopping-seg-tab"));
    const tabPanels = Array.from(document.querySelectorAll(".shopping-tab-panel"));
    const extrasForm = document.getElementById("shopping-extras-form");
    const extraInput = document.getElementById("shopping-extra-input");
    const extrasListEl = document.getElementById("shopping-extras-list");
    const extrasEmptyEl = document.getElementById("shopping-extras-empty");
    const progressLabel = document.getElementById("shopping-progress-label");
    const progressPct = document.getElementById("shopping-progress-pct");
    const progressFill = document.getElementById("shopping-progress-fill");
    const countFreshEl = document.getElementById("count-fresh");
    const countPantryEl = document.getElementById("count-pantry");
    const countExtrasEl = document.getElementById("count-extras");
    const toastEl = document.getElementById("shopping-toast");
    const waPreviewEl = document.getElementById("shopping-wa-preview");

    function showToast(message) {
      if (!toastEl) return;
      toastEl.textContent = message;
      toastEl.classList.add("show");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(function() {
        toastEl.classList.remove("show");
      }, 2400);
    }

    function copyTextToClipboard(text, toastMessage) {
      if (waPreviewEl) {
        waPreviewEl.textContent = text;
        waPreviewEl.hidden = false;
      }

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function() {
          showToast(toastMessage);
        }).catch(function() {
          fallbackCopy(text, toastMessage);
        });
      } else {
        fallbackCopy(text, toastMessage);
      }
    }

    function fallbackCopy(text, toastMessage) {
      const helper = document.createElement("textarea");
      helper.value = text;
      helper.setAttribute("readonly", "");
      helper.style.position = "fixed";
      helper.style.opacity = "0";
      document.body.appendChild(helper);
      helper.select();
      try {
        document.execCommand("copy");
      } catch (e) {
        // Preview box remains visible for manual copy
      }
      document.body.removeChild(helper);
      showToast(toastMessage);
    }

    function renderExtras() {
      if (!extrasListEl) return;
      extrasListEl.innerHTML = "";
      if (extrasEmptyEl) extrasEmptyEl.hidden = extrasList.length > 0;

      extrasList.forEach(function(extra) {
        const row = document.createElement("div");
        row.className = "shopping-check-row" + (extra.checked ? " checked" : "");
        row.setAttribute("role", "checkbox");
        row.setAttribute("tabindex", "0");
        row.setAttribute("aria-checked", extra.checked ? "true" : "false");

        const box = document.createElement("span");
        box.className = "shopping-check-box";
        box.setAttribute("aria-hidden", "true");
        box.textContent = extra.checked ? "✓" : "";

        const main = document.createElement("div");
        main.className = "shopping-item-main";
        const title = document.createElement("span");
        title.className = "shopping-item-title";
        title.textContent = extra.name;
        main.appendChild(title);

        const removeBtn = document.createElement("button");
        removeBtn.type = "button";
        removeBtn.className = "shopping-extra-remove";
        removeBtn.textContent = "✕";
        removeBtn.setAttribute("aria-label", I18N.extrasRemove);
        removeBtn.addEventListener("click", function(ev) {
          ev.stopPropagation();
          extrasList = extrasList.filter(function(item) { return item.id !== extra.id; });
          saveJSON(extrasStorageKey, extrasList);
          renderAll();
        });

        row.addEventListener("click", function() {
          extra.checked = !extra.checked;
          saveJSON(extrasStorageKey, extrasList);
          renderAll();
        });

        row.addEventListener("keydown", function(ev) {
          if (ev.key === "Enter" || ev.key === " ") {
            ev.preventDefault();
            extra.checked = !extra.checked;
            saveJSON(extrasStorageKey, extrasList);
            renderAll();
          }
        });

        row.appendChild(box);
        row.appendChild(main);
        row.appendChild(removeBtn);
        extrasListEl.appendChild(row);
      });
    }

    function renderAll() {
      let freshPending = 0;
      let pantryPending = 0;
      let doneItems = 0;

      itemRows.forEach(function(row) {
        const key = row.dataset.itemKey;
        const isChecked = Boolean(checkedMap[key]);
        row.classList.toggle("checked", isChecked);
        row.setAttribute("aria-checked", isChecked ? "true" : "false");
        const box = row.querySelector(".shopping-check-box");
        if (box) box.textContent = isChecked ? "✓" : "";

        if (isChecked) {
          doneItems += 1;
        } else if (row.dataset.itemGroup === "pantry") {
          pantryPending += 1;
        } else {
          freshPending += 1;
        }
      });

      renderExtras();

      const extrasPending = extrasList.filter(function(e) { return !e.checked; }).length;
      const extrasDone = extrasList.length - extrasPending;
      const totalAll = itemRows.length + extrasList.length;
      const doneAll = doneItems + extrasDone;
      const pct = totalAll > 0 ? Math.round((doneAll / totalAll) * 100) : 0;

      if (countFreshEl) countFreshEl.textContent = freshPending;
      if (countPantryEl) countPantryEl.textContent = pantryPending;
      if (countExtrasEl) countExtrasEl.textContent = extrasPending;

      if (progressLabel && totalAll > 0) {
        progressLabel.textContent = doneAll === totalAll
          ? I18N.allDone
          : I18N.progressTemplate.replace("__DONE__", doneAll).replace("__TOTAL__", totalAll);
      }
      if (progressPct) progressPct.textContent = pct + "%";
      if (progressFill) progressFill.style.width = pct + "%";
    }

    itemRows.forEach(function(row) {
      function toggleRow() {
        const key = row.dataset.itemKey;
        checkedMap[key] = !checkedMap[key];
        saveJSON(checkedStorageKey, checkedMap);
        renderAll();
      }
      row.addEventListener("click", toggleRow);
      row.addEventListener("keydown", function(ev) {
        if (ev.key === "Enter" || ev.key === " ") {
          ev.preventDefault();
          toggleRow();
        }
      });
    });

    document.querySelectorAll(".shopping-usage-toggle").forEach(function(btn) {
      btn.addEventListener("click", function(ev) {
        ev.stopPropagation();
        const list = btn.nextElementSibling;
        if (!list) return;
        const expanded = btn.getAttribute("aria-expanded") === "true";
        btn.setAttribute("aria-expanded", expanded ? "false" : "true");
        list.hidden = expanded;
      });
    });

    tabButtons.forEach(function(btn) {
      btn.addEventListener("click", function() {
        const target = btn.dataset.tab;
        tabButtons.forEach(function(other) {
          const active = other === btn;
          other.classList.toggle("active", active);
          other.setAttribute("aria-selected", active ? "true" : "false");
        });
        tabPanels.forEach(function(panel) {
          panel.hidden = panel.dataset.panel !== target;
        });
      });
    });

    document.querySelectorAll("[data-copy-section]").forEach(function(btn) {
      btn.addEventListener("click", function() {
        const card = btn.closest(".shopping-section-card");
        if (!card) return;
        const section = card.dataset.section;
        const emoji = card.dataset.emoji || "📦";
        const pendingRows = Array.from(card.querySelectorAll(".shopping-check-row")).filter(function(row) {
          return !checkedMap[row.dataset.itemKey];
        });

        if (pendingRows.length === 0) {
          showToast(I18N.nothingToCopy);
          return;
        }

        const header = I18N.whatsappSectionTemplate
          .replace("__EMOJI__", emoji)
          .replace("__SECTION__", section);
        const lines = [ header ];
        pendingRows.forEach(function(row) {
          lines.push("- " + row.dataset.itemName + ": " + row.dataset.itemQty);
        });
        copyTextToClipboard(lines.join("\n"), I18N.copiedSectionTemplate.replace("__SECTION__", section));
      });
    });

    const copyAllBtn = document.getElementById("btn-copy-whatsapp");
    if (copyAllBtn) {
      copyAllBtn.addEventListener("click", function() {
        const lines = [ I18N.whatsappHeader ];
        const grouped = new Map();

        itemRows.forEach(function(row) {
          if (row.dataset.itemGroup !== "fresh") return;
          if (checkedMap[row.dataset.itemKey]) return;
          const sec = row.dataset.itemSection;
          if (!grouped.has(sec)) {
            grouped.set(sec, { emoji: row.dataset.itemEmoji || "📦", items: [] });
          }
          grouped.get(sec).items.push("- " + row.dataset.itemName + ": " + row.dataset.itemQty);
        });

        grouped.forEach(function(data, sec) {
          lines.push("");
          lines.push("*" + data.emoji + " " + sec + "*");
          data.items.forEach(function(line) { lines.push(line); });
        });

        const pendingExtras = extrasList.filter(function(e) { return !e.checked; });
        if (pendingExtras.length > 0) {
          lines.push("");
          lines.push(I18N.whatsappExtrasHeader);
          pendingExtras.forEach(function(e) { lines.push("- " + e.name); });
        }

        if (lines.length === 1) {
          showToast(I18N.nothingToCopy);
          return;
        }

        copyTextToClipboard(lines.join("\n"), I18N.copiedToast);
      });
    }

    const clearBtn = document.getElementById("btn-clear-checked");
    if (clearBtn) {
      clearBtn.addEventListener("click", function() {
        checkedMap = {};
        extrasList.forEach(function(e) { e.checked = false; });
        saveJSON(checkedStorageKey, checkedMap);
        saveJSON(extrasStorageKey, extrasList);
        if (waPreviewEl) waPreviewEl.hidden = true;
        renderAll();
      });
    }

    if (extrasForm && extraInput) {
      extrasForm.addEventListener("submit", function(ev) {
        ev.preventDefault();
        const text = extraInput.value.trim();
        if (!text) return;
        extrasList.push({ id: "ext-" + Date.now(), name: text, checked: false });
        saveJSON(extrasStorageKey, extrasList);
        extraInput.value = "";
        renderAll();
      });
    }

    renderAll();
  })();
</script>
