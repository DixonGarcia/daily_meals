<div class="header-actions">
  <h2 class="section-title">🥕 Ingredient Catalog</h2>
  <a href="<%= new_ingredient_path %>" class="btn-action">➕ Add New Ingredient</a>
</div>

<div class="card" style="max-width: 800px; margin: 0 auto;">
  <% if @ingredients.empty? %>
    <p style="color: var(--text-secondary); text-align: center; font-style: italic;">No ingredients in the catalog yet.</p>
  <% else %>
    <table class="table-card">
      <thead>
        <tr>
          <th>Ingredient Name</th>
          <th>Supermarket Section</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @ingredients.each do |ingredient| %>
          <tr>
            <td style="font-weight: 700; color: var(--accent-cyan);"><%= ingredient.name %></td>
            <td><%= ingredient.supermarket_section %></td>
            <td style="text-align: right;">
              <a href="<%= edit_ingredient_path(ingredient) %>" class="btn-secondary" style="font-size: 0.85rem; padding: 0.4rem 0.8rem; margin-right: 0.5rem;">✏️ Edit</a>
              <%= button_to '❌ Delete', ingredient_path(ingredient), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn-danger', style: 'display: inline-block; padding: 0.4rem 0.8rem; font-size: 0.85rem;' %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
