<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t('layout.title') %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#ffffff">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <% base_prefix = root_path == "/" ? "" : root_path.chomp("/") %>
    <link rel="manifest" href="<%= pwa_manifest_path(format: :json) %>">
    <link rel="icon" href="<%= base_prefix %>/icon.png" type="image/png">
    <link rel="icon" href="<%= base_prefix %>/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%= base_prefix %>/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body>
    <!-- Navbar -->
    <nav class="app-nav">
      <div class="nav-container">
        <a href="<%= root_path %>" class="nav-logo">
          <span class="logo-emoji">🍳</span>
          <span class="logo-text">DailyMeals</span>
        </a>
        <div class="nav-links">
          <a href="<%= root_path %>" class="nav-link <%= 'active' if controller_name == 'meal_plans' %>"><%= t('layout.calendar') %></a>
          <a href="<%= shopping_list_path %>" class="nav-link <%= 'active' if controller_name == 'shopping_lists' %>"><%= t('layout.shopping_list') %></a>
          <a href="<%= dishes_path %>" class="nav-link <%= 'active' if %w[dishes ingredients].include?(controller_name) %>"><%= t('layout.dishes') %></a>
          <% if authenticated? %>
            <a href="<%= settings_path %>" class="nav-link <%= 'active' if %w[settings api_keys meal_plan_histories].include?(controller_name) %>"><%= t('layout.settings') %></a>
            <div class="nav-logout-wrapper">
              <%= button_to t('layout.logout'), session_path, method: :delete, class: "nav-logout-btn" %>
            </div>
          <% else %>
            <div class="nav-logout-wrapper">
              <a href="<%= new_session_path %>" class="nav-login-btn"><%= t('layout.login') %></a>
            </div>
          <% end %>
        </div>
      </div>
    </nav>

    <!-- Main Container -->
    <main class="main-content">
      <!-- Flash Notifications -->
      <% if flash[:notice].present? %>
        <div class="flash flash-notice"><%= flash[:notice] %></div>
      <% end %>
      <% if flash[:alert].present? %>
        <div class="flash flash-alert"><%= flash[:alert] %></div>
      <% end %>

      <%= yield %>
    </main>

    <script>
      (function() {
        // Reliable native confirmations for data-confirm / data-turbo-confirm without Turbo/UJS
        document.addEventListener("click", function(event) {
          const el = event.target.closest("[data-confirm], [data-turbo-confirm]");
          if (!el || el.tagName === "FORM") return;
          const message = el.getAttribute("data-confirm") || el.getAttribute("data-turbo-confirm");
          if (message && !window.confirm(message)) {
            event.preventDefault();
            event.stopPropagation();
          }
        }, true);

        document.addEventListener("submit", function(event) {
          const form = event.target;
          if (!form || !form.getAttribute) return;
          const message = form.getAttribute("data-confirm") || form.getAttribute("data-turbo-confirm");
          if (message && !window.confirm(message)) {
            event.preventDefault();
          }
        }, true);

        if ("serviceWorker" in navigator) {
          window.addEventListener("load", function() {
            navigator.serviceWorker.register("<%= pwa_service_worker_path(format: :js) %>").catch(function() {});
          });
        }
      })();
    </script>
  </body>
</html>
