<%= form_with model: dish, local: true, class: "card", style: "max-width: 600px; margin: 0 auto;" do |f| %>
  <% if dish.errors.any? %>
    <div class="flash flash-alert" style="margin-bottom: 1.5rem;">
      <h4 style="margin-bottom: 0.5rem;"><%= t('dishes.form.errors_title') %></h4>
      <ul>
        <% dish.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, t('dishes.form.name_label'), class: "form-label" %>
    <%= f.text_field :name, class: "form-input", placeholder: t('dishes.form.name_placeholder') %>
  </div>

  <div class="form-group">
    <%= f.label :category, t('dishes.form.category_label'), class: "form-label" %>
    <%= f.select :category, Dish::CATEGORIES.map { |c| [t("dish_categories.#{c.downcase}", default: c), c] }, { include_blank: t('dishes.form.category_placeholder') }, { class: "form-input" } %>
  </div>

  <div class="form-group" style="margin-top: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
      <h3 class="form-label" style="margin-bottom: 0; color: var(--accent-cyan);"><%= t('dishes.form.ingredients_label') %></h3>
      <button type="button" id="add-ingredient-btn" class="btn-action" style="font-size: 0.8rem; padding: 0.4rem 0.8rem;">
        <%= t('dishes.form.add_ingredient') %>
      </button>
    </div>

    <!-- Container for dynamic ingredients -->
    <div id="ingredients-container">
      <%= f.fields_for :dish_ingredients do |di| %>
        <div class="nested-fields ingredient-row">
          <%= di.hidden_field :id %>
          
          <%= di.select :ingredient_id, 
                        options_from_collection_for_select(@ingredients, :id, :name, di.object.ingredient_id), 
                        { include_blank: t('dishes.form.select_ingredient') }, 
                        { class: "meal-dish-selector", style: "width: 50%;" } %>
          
          <%= di.text_field :suggested_quantity, class: "form-input", placeholder: t('dishes.form.quantity_placeholder'), style: "width: 35%;" %>
          
          <!-- Destroy checkbox wrapper -->
          <div style="width: 15%; text-align: center;">
            <%= di.hidden_field :_destroy, class: "destroy-flag" %>
            <button type="button" class="btn-danger remove-existing-row-btn">❌</button>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div style="display: flex; gap: 1rem; margin-top: 2.5rem;">
    <%= f.submit dish.new_record? ? t('dishes.form.submit_create') : t('dishes.form.submit_update'), class: "btn-action", style: "flex: 1;" %>
    <a href="<%= dishes_path %>" class="btn-secondary" style="flex: 1; text-align: center; display: flex; align-items: center; justify-content: center;"><%= t('dishes.form.cancel') %></a>
  </div>
<% end %>

<!-- Hidden row template for adding new ingredients via Javascript -->
<div id="ingredient-row-template" style="display: none;">
  <div class="nested-fields ingredient-row new-row">
    <select name="dish[dish_ingredients_attributes][__NEW_INDEX__][ingredient_id]" class="meal-dish-selector" style="width: 50%;">
      <option value=""><%= t('dishes.form.select_ingredient') %></option>
      <% @ingredients.each do |ing| %>
        <option value="<%= ing.id %>"><%= ing.name %></option>
      <% end %>
    </select>
    
    <input type="text" name="dish[dish_ingredients_attributes][__NEW_INDEX__][suggested_quantity]" class="form-input" placeholder="<%= t('dishes.form.quantity_placeholder') %>" style="width: 35%;">
    
    <div style="width: 15%; text-align: center;">
      <button type="button" class="btn-danger remove-new-row-btn">❌</button>
    </div>
  </div>
</div>

<script>
  document.addEventListener("turbo:load", function() {
    const container = document.getElementById("ingredients-container");
    const addBtn = document.getElementById("add-ingredient-btn");
    const template = document.getElementById("ingredient-row-template");

    if (!container || !addBtn || !template) return;

    // Remove new rows directly from DOM
    container.addEventListener("click", function(e) {
      if (e.target && e.target.classList.contains("remove-new-row-btn")) {
        e.preventDefault();
        e.target.closest(".ingredient-row").remove();
      }

      // Mark existing rows as destroyed, and hide them
      if (e.target && e.target.classList.contains("remove-existing-row-btn")) {
        e.preventDefault();
        const row = e.target.closest(".ingredient-row");
        const destroyFlag = row.querySelector(".destroy-flag");
        if (destroyFlag) {
          destroyFlag.value = "1";
        }
        row.style.display = "none";
      }
    });

    // Add new row from template
    addBtn.addEventListener("click", function(e) {
      e.preventDefault();
      const uniqueIndex = "new_" + Date.now() + "_" + Math.floor(Math.random() * 1000);
      let html = template.innerHTML;
      html = html.replace(/__NEW_INDEX__/g, uniqueIndex);
      
      const tempDiv = document.createElement("div");
      tempDiv.innerHTML = html.trim();
      const newRow = tempDiv.firstChild;
      
      container.appendChild(newRow);
    });
  });
</script>
