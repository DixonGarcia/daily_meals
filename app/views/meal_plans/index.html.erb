<div class="mobile-quick-jumps">
  <% if authenticated? %>
    <a href="#ai-copilot-panel" class="quick-jump-pill jump-ai"><%= t('ai_chat_sessions.jump_to_chat') %></a>
  <% end %>
  <a href="<%= shopping_list_path %>" class="quick-jump-pill jump-cart"><%= t('ai_chat_sessions.jump_to_shopping') %></a>
</div>

<div class="dashboard-grid">
  <!-- Left Side: Daily / Weekly Calendar -->
  <div>
    <div class="calendar-header-row">
      <h2 class="section-title" style="margin-bottom: 0;"><%= t('meal_plans.index.title') %></h2>
      <div class="view-toggle" role="tablist">
        <a href="<%= root_path(view: 'day', day: @selected_day) %>"
           class="view-toggle-btn <%= 'active' if @view_mode == 'day' %>">
          <%= t('meal_plans.index.view_day') %>
        </a>
        <a href="<%= root_path(view: 'week') %>"
           class="view-toggle-btn <%= 'active' if @view_mode == 'week' %>">
          <%= t('meal_plans.index.view_week') %>
        </a>
      </div>
    </div>

    <% if @view_mode == "day" %>
      <div class="day-chips-bar">
        <% MealPlan::DAYS_OF_WEEK.each do |day_name| %>
          <% is_selected = (day_name == @selected_day) %>
          <% is_today = (day_name == @today_key) %>
          <a href="<%= root_path(view: 'day', day: day_name) %>"
             class="day-chip <%= 'active' if is_selected %> <%= 'is-today' if is_today %>">
            <span><%= t("days_of_week_short.#{day_name.downcase}") %></span>
            <% if is_today %>
              <span class="today-dot" title="<%= t('meal_plans.index.today_badge') %>"></span>
            <% end %>
          </a>
        <% end %>
      </div>

      <div class="calendar-single-day">
        <%= render "meal_plans/day_card",
                   day: @selected_day,
                   plan: @meal_plans[@selected_day],
                   today_key: @today_key,
                   view_mode: @view_mode,
                   detailed: true %>

        <% tomorrow_name = t("days_of_week.#{@tomorrow_key.downcase}", default: @tomorrow_key) %>
        <% tomorrow_prefix = @selected_day == @today_key ? t('meal_plans.index.tomorrow_prefix', day: tomorrow_name) : t('meal_plans.index.next_day_prefix', day: tomorrow_name) %>
        <a href="<%= root_path(view: 'day', day: @tomorrow_key) %>" class="tomorrow-radar-strip">
          <div class="tomorrow-radar-top">
            <span class="tomorrow-radar-label"><%= tomorrow_prefix %></span>
            <span class="tomorrow-radar-cta"><%= t('meal_plans.index.view_next_day') %></span>
          </div>

          <% if @tomorrow_plan.lunch_dish.present? || @tomorrow_plan.dinner_dish.present? %>
            <div class="tomorrow-radar-dishes">
              <span>☀️ <strong><%= @tomorrow_plan.lunch_dish&.name || t('meal_plans.index.none') %></strong></span>
              <span class="tomorrow-radar-sep">·</span>
              <span>🌙 <strong><%= @tomorrow_plan.dinner_dish&.name || t('meal_plans.index.none') %></strong></span>
            </div>
          <% else %>
            <div class="tomorrow-radar-empty"><%= t('meal_plans.index.tomorrow_empty') %></div>
          <% end %>

          <% if @tomorrow_defrost_items.any? %>
            <div class="defrost-pill">
              <%= t('meal_plans.index.defrost_alert', items: @tomorrow_defrost_items.join(", ")) %>
            </div>
          <% end %>
        </a>
      </div>
    <% else %>
      <% if authenticated? %>
        <%= form_with url: update_week_meal_plans_path, method: :patch, local: true, id: "weekly-meal-plan-form" do %>
          <div class="week-save-bar">
            <span class="week-save-hint" id="week-save-hint"><%= t('meal_plans.index.week_save_hint') %></span>
            <button type="submit" class="btn-action week-save-btn" id="week-save-btn-top">
              <%= t('meal_plans.index.save_week') %>
            </button>
          </div>

          <div class="calendar-grid">
            <% MealPlan::DAYS_OF_WEEK.each do |day| %>
              <%= render "meal_plans/day_card",
                         day: day,
                         plan: @meal_plans[day],
                         today_key: @today_key,
                         view_mode: @view_mode,
                         detailed: false %>
            <% end %>
          </div>

          <div class="week-save-footer">
            <button type="submit" class="btn-action week-save-btn-full">
              <%= t('meal_plans.index.save_week') %>
            </button>
          </div>
        <% end %>
      <% else %>
        <div class="calendar-grid">
          <% MealPlan::DAYS_OF_WEEK.each do |day| %>
            <%= render "meal_plans/day_card",
                       day: day,
                       plan: @meal_plans[day],
                       today_key: @today_key,
                       view_mode: @view_mode,
                       detailed: false %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <!-- Right Side: Sidebar (Gemini Pseudo-Chat & Shopping List) -->
  <div class="sidebar-panel">
    <% if authenticated? %>
    <!-- Streamlined Single-Thread Gemini AI Copilot Panel -->
    <div id="ai-copilot-panel" class="card ai-copilot-card">
      <div class="copilot-header-row">
        <h3 class="section-title copilot-main-title"><%= t('meal_plans.index.ai_copilot') %></h3>
        <div class="copilot-session-actions">
          <%= button_to t('ai_chat_sessions.reset_chat'),
                        ai_chat_sessions_path,
                        method: :post,
                        class: "btn-session-new" %>
        </div>
      </div>

      <a href="<%= settings_path(tab: 'diet') %>" class="diet-profile-badge <%= 'diet-profile-badge-empty' unless @household_setting.guidelines_present? %>">
        <% if @household_setting.guidelines_present? %>
          <%= t('ai_chat_sessions.diet_profile_active', servings: @household_setting.servings_multiplier) %>
        <% else %>
          <%= t('ai_chat_sessions.diet_profile_setup', servings: @household_setting.servings_multiplier) %>
        <% end %>
      </a>

      <% active_params = @active_chat_session.effective_parameters %>

      <!-- Message Thread -->
      <div id="copilot-chat-thread" class="copilot-chat-thread">
        <% if @active_chat_session.ai_chat_messages.empty? %>
          <div class="copilot-empty-state">
            <p><%= t('ai_chat_sessions.empty_chat') %></p>
            <div class="quick-prompts-list">
              <button type="button" class="quick-prompt-btn" data-prompt="<%= t('ai_chat_sessions.quick_prompt_1') %>">
                ✨ <%= t('ai_chat_sessions.quick_prompt_1') %>
              </button>
              <button type="button" class="quick-prompt-btn" data-prompt="<%= t('ai_chat_sessions.quick_prompt_2') %>">
                🥗 <%= t('ai_chat_sessions.quick_prompt_2') %>
              </button>
              <button type="button" class="quick-prompt-btn" data-prompt="<%= t('ai_chat_sessions.quick_prompt_3') %>">
                📆 <%= t('ai_chat_sessions.quick_prompt_3') %>
              </button>
            </div>
          </div>
        <% else %>
          <% @active_chat_session.ai_chat_messages.each do |msg| %>
            <div class="chat-bubble <%= msg.user? ? 'chat-bubble-user' : 'chat-bubble-assistant' %>">
              <div class="chat-bubble-text"><%= msg.content %></div>
            </div>
          <% end %>
        <% end %>
      </div>

      <!-- Proposed Weekly Menu & New Dishes Preview with Checkboxes & Editable Quantities -->
      <% active_scope = active_params["days_scope"].to_s %>
      <% has_plan = active_scope != "none" && @active_chat_session.proposed_plan.present? %>
      <% has_new_dishes = @active_chat_session.proposed_dishes.present? %>
      <% if has_plan || has_new_dishes %>
        <%= form_with url: apply_ai_chat_session_path(@active_chat_session), method: :post, local: true, class: "proposed-menu-preview" do %>
          <div class="proposed-menu-header">
            <span class="proposed-menu-title"><%= t('ai_chat_sessions.preview_title') %></span>
            <span class="proposed-status-badge <%= @active_chat_session.applied? ? 'badge-applied' : 'badge-ready' %>">
              <%= @active_chat_session.applied? ? t('ai_chat_sessions.status_applied') : t('ai_chat_sessions.status_ready') %>
            </span>
          </div>

          <% if has_new_dishes %>
            <div class="proposed-new-dishes-box">
              <div class="proposed-new-dishes-title"><%= t('ai_chat_sessions.proposed_dishes_title') %></div>
              <p class="proposed-new-dishes-hint"><%= t('ai_chat_sessions.proposed_dishes_hint') %></p>

              <% @active_chat_session.proposed_dishes.each_with_index do |dish_entry, d_idx| %>
                <% d_name = (dish_entry["name"] || dish_entry[:name]).to_s %>
                <% raw_cats = Array(dish_entry["categories"] || dish_entry[:categories]).reject(&:blank?) %>
                <% d_cats = raw_cats.presence || [ (dish_entry["category"] || dish_entry[:category]).to_s.presence || "Lunch" ] %>
                <% d_ings = Array(dish_entry["ingredients"] || dish_entry[:ingredients]) %>
                <div class="proposed-dish-card">
                  <div class="proposed-dish-header">
                    <label class="proposed-dish-check-label">
                      <input type="hidden" name="dish_overrides[<%= d_idx %>][included]" value="0">
                      <input type="checkbox" name="dish_overrides[<%= d_idx %>][included]" value="1" checked>
                      <strong><%= d_name %></strong>
                    </label>
                    <div class="category-tags-group">
                      <% d_cats.each do |cat_name| %>
                        <span class="proposed-dish-cat-badge">
                          <%= t("dish_categories.#{cat_name.downcase}", default: cat_name) %>
                        </span>
                      <% end %>
                    </div>
                  </div>
                  <input type="hidden" name="dish_overrides[<%= d_idx %>][name]" value="<%= d_name %>">
                  <input type="hidden" name="dish_overrides[<%= d_idx %>][category]" value="<%= d_cats.first %>">
                  <% d_cats.each do |cat_name| %>
                    <input type="hidden" name="dish_overrides[<%= d_idx %>][categories][]" value="<%= cat_name %>">
                  <% end %>

                  <div class="proposed-ing-list">
                    <% d_ings.each_with_index do |ing_entry, i_idx| %>
                      <% i_name = (ing_entry["name"] || ing_entry[:name]).to_s %>
                      <% i_sec = (ing_entry["supermarket_section"] || ing_entry[:supermarket_section]).to_s.presence || "Otros" %>
                      <% i_qty = (ing_entry["suggested_quantity"] || ing_entry[:suggested_quantity]).to_s.presence || "1 unidad" %>
                      <div class="proposed-ing-row">
                        <label class="proposed-ing-check-label">
                          <input type="hidden" name="dish_overrides[<%= d_idx %>][ingredients][<%= i_idx %>][included]" value="0">
                          <input type="checkbox" name="dish_overrides[<%= d_idx %>][ingredients][<%= i_idx %>][included]" value="1" checked>
                          <span class="proposed-ing-name"><%= i_name %></span>
                          <small class="proposed-ing-sec">(<%= i_sec %>)</small>
                        </label>
                        <input type="hidden" name="dish_overrides[<%= d_idx %>][ingredients][<%= i_idx %>][name]" value="<%= i_name %>">
                        <input type="hidden" name="dish_overrides[<%= d_idx %>][ingredients][<%= i_idx %>][supermarket_section]" value="<%= i_sec %>">
                        <input type="text"
                               name="dish_overrides[<%= d_idx %>][ingredients][<%= i_idx %>][suggested_quantity]"
                               value="<%= i_qty %>"
                               class="proposed-qty-input"
                               aria-label="Cantidad de <%= i_name %>">
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>

          <% if has_plan %>
            <% include_lunch_flag = ActiveModel::Type::Boolean.new.cast(active_params["include_lunch"]) %>
            <% include_dinner_flag = ActiveModel::Type::Boolean.new.cast(active_params["include_dinner"]) %>
            <div class="proposed-days-list">
              <% @active_chat_session.proposed_plan.each do |entry| %>
                <% day_key = (entry["day"] || entry[:day]).to_s %>
                <% existing_day = @meal_plans[day_key] %>
                <% lunch_dish = @dishes_by_id[(entry["lunch_dish_id"] || entry[:lunch_dish_id]).to_i] %>
                <% dinner_dish = @dishes_by_id[(entry["dinner_dish_id"] || entry[:dinner_dish_id]).to_i] %>
                <% lunch_new = (entry["lunch_new_dish_name"] || entry[:lunch_new_dish_name]).to_s.presence %>
                <% dinner_new = (entry["dinner_new_dish_name"] || entry[:dinner_new_dish_name]).to_s.presence %>
                <% lunch_targeted = include_lunch_flag && (lunch_dish.present? || lunch_new.present?) %>
                <% dinner_targeted = include_dinner_flag && (dinner_dish.present? || dinner_new.present?) %>
                <div class="proposed-day-row">
                  <strong class="proposed-day-name"><%= t("days_of_week.#{day_key.downcase}", default: day_key) %></strong>
                  <div class="proposed-day-dishes">
                    <span>
                      ☀️ <% if lunch_targeted %>
                        <%= lunch_dish&.name || "🆕 #{lunch_new}" %>
                      <% else %>
                        <span class="slot-kept-muted"><%= existing_day&.lunch_dish&.name || t('ai_chat_sessions.slot_kept') %></span>
                      <% end %>
                    </span>
                    <span>
                      🌙 <% if dinner_targeted %>
                        <%= dinner_dish&.name || "🆕 #{dinner_new}" %>
                      <% else %>
                        <span class="slot-kept-muted"><%= existing_day&.dinner_dish&.name || t('ai_chat_sessions.slot_kept') %></span>
                      <% end %>
                    </span>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>

          <button type="submit" class="update-day-btn btn-apply-menu">
            <% if has_new_dishes && !has_plan %>
              <%= t('ai_chat_sessions.apply_dishes_only_button') %>
            <% elsif has_new_dishes %>
              <%= t('ai_chat_sessions.apply_with_dishes_button') %>
            <% else %>
              <%= t('ai_chat_sessions.apply_button') %>
            <% end %>
          </button>
        <% end %>
      <% end %>

      <!-- Chat Form with Structured Parameters -->
      <%= form_with scope: :ai_chat_message,
                    url: ai_chat_session_ai_chat_messages_path(@active_chat_session),
                    method: :post,
                    local: true,
                    id: "copilot-chat-form",
                    class: "copilot-chat-form" do |f| %>
        <div class="copilot-params-panel">
          <span class="copilot-params-title"><%= t('ai_chat_sessions.params_title') %></span>
          <div class="param-chips-grid">
            <label class="param-chip">
              <%= f.radio_button :days_scope, "weekdays", checked: !%w[full_week none].include?(active_scope) %>
              <span><%= t('ai_chat_sessions.days_weekdays') %></span>
            </label>
            <label class="param-chip">
              <%= f.radio_button :days_scope, "full_week", checked: active_scope == "full_week" %>
              <span><%= t('ai_chat_sessions.days_full_week') %></span>
            </label>
            <label class="param-chip">
              <%= f.radio_button :days_scope, "none", checked: active_scope == "none" %>
              <span><%= t('ai_chat_sessions.days_none') %></span>
            </label>
            <label class="param-chip" id="chip-include-lunch">
              <%= f.check_box :include_lunch, checked: active_scope != "none" && ActiveModel::Type::Boolean.new.cast(active_params["include_lunch"]) %>
              <span><%= t('ai_chat_sessions.slot_lunch') %></span>
            </label>
            <label class="param-chip" id="chip-include-dinner">
              <%= f.check_box :include_dinner, checked: active_scope != "none" && ActiveModel::Type::Boolean.new.cast(active_params["include_dinner"]) %>
              <span><%= t('ai_chat_sessions.slot_dinner') %></span>
            </label>
            <label class="param-chip" id="chip-avoid-repetition">
              <%= f.check_box :avoid_repetition, checked: ActiveModel::Type::Boolean.new.cast(active_params["avoid_repetition"]) %>
              <span><%= t('ai_chat_sessions.avoid_repetition') %></span>
            </label>
          </div>
        </div>

        <div class="copilot-input-row">
          <%= f.text_field :content,
                           id: "copilot-message-input",
                           class: "ai-text-input copilot-message-input",
                           placeholder: t('ai_chat_sessions.message_placeholder'),
                           required: true,
                           autocomplete: "off" %>
          <%= f.submit t('ai_chat_sessions.send_button'),
                       id: "copilot-send-btn",
                       class: "btn-ai-violet copilot-send-btn" %>
        </div>
      <% end %>
    </div>
    <% end %>

    <!-- Compact Shopping List CTA Card -->
    <div id="shopping-list-panel" class="card shopping-summary-card">
      <div class="shopping-summary-head">
        <h3 class="section-title shopping-summary-title"><%= t('meal_plans.index.shopping_list') %></h3>
        <% if @shopping_summary[:total_count] > 0 %>
          <span class="shopping-summary-pill">
            <%= t('meal_plans.index.shopping_summary_count',
                  fresh: @shopping_summary[:fresh_count],
                  pantry: @shopping_summary[:pantry_count],
                  servings: @servings) %>
          </span>
        <% end %>
      </div>

      <% if @shopping_summary[:total_count].zero? %>
        <p class="empty-shopping-list"><%= t('meal_plans.index.no_ingredients') %></p>
      <% else %>
        <div class="shopping-summary-stops">
          <% @shopping_summary[:fresh].each do |section, items| %>
            <span class="shopping-stop-badge">
              <%= shopping_section_emoji(section) %> <%= section %> (<%= items.size %>)
            </span>
          <% end %>
        </div>
        <a href="<%= shopping_list_path %>" class="btn-action shopping-summary-cta">
          <%= t('meal_plans.index.open_shopping_list') %>
        </a>
      <% end %>
    </div>
  </div>
</div>

<% if authenticated? %>
<script>
  (function() {
    const weeklyForm = document.getElementById("weekly-meal-plan-form");
    const weekSaveHint = document.getElementById("week-save-hint");
    if (weeklyForm && weekSaveHint) {
      weeklyForm.querySelectorAll(".week-dish-selector").forEach(function(select) {
        select.addEventListener("change", function() {
          select.classList.add("selector-dirty");
          weekSaveHint.textContent = "<%= j t('meal_plans.index.week_unsaved_changes') %>";
          weekSaveHint.classList.add("week-save-hint-dirty");
        });
      });
    }

    const chatThread = document.getElementById("copilot-chat-thread");
    if (chatThread) {
      chatThread.scrollTop = chatThread.scrollHeight;
    }

    const messageInput = document.getElementById("copilot-message-input");
    const chatForm = document.getElementById("copilot-chat-form");
    const sendBtn = document.getElementById("copilot-send-btn");

    const scopeRadios = document.querySelectorAll('input[name="ai_chat_message[days_scope]"]');
    const lunchCheckbox = document.querySelector('input[type="checkbox"][name="ai_chat_message[include_lunch]"]');
    const dinnerCheckbox = document.querySelector('input[type="checkbox"][name="ai_chat_message[include_dinner]"]');
    const avoidCheckbox = document.querySelector('input[type="checkbox"][name="ai_chat_message[avoid_repetition]"]');

    function syncCopilotScopeControls() {
      const checkedScope = document.querySelector('input[name="ai_chat_message[days_scope]"]:checked');
      const isNone = checkedScope && checkedScope.value === "none";
      [lunchCheckbox, dinnerCheckbox, avoidCheckbox].forEach(function(cb) {
        if (!cb) return;
        const chip = cb.closest(".param-chip");
        if (isNone) {
          if (cb !== avoidCheckbox) cb.checked = false;
          if (chip) chip.classList.add("chip-disabled");
        } else {
          if (chip) chip.classList.remove("chip-disabled");
        }
      });
    }

    scopeRadios.forEach(function(radio) {
      radio.addEventListener("change", function() {
        if (radio.value !== "none" && lunchCheckbox && dinnerCheckbox && !lunchCheckbox.checked && !dinnerCheckbox.checked) {
          lunchCheckbox.checked = true;
          dinnerCheckbox.checked = true;
        }
        syncCopilotScopeControls();
      });
    });

    [lunchCheckbox, dinnerCheckbox].forEach(function(cb) {
      if (!cb) return;
      cb.addEventListener("change", function() {
        if (!lunchCheckbox.checked && !dinnerCheckbox.checked) {
          const noneRadio = document.querySelector('input[name="ai_chat_message[days_scope]"][value="none"]');
          if (noneRadio) noneRadio.checked = true;
        } else {
          const checkedScope = document.querySelector('input[name="ai_chat_message[days_scope]"]:checked');
          if (checkedScope && checkedScope.value === "none") {
            const weekdaysRadio = document.querySelector('input[name="ai_chat_message[days_scope]"][value="weekdays"]');
            if (weekdaysRadio) weekdaysRadio.checked = true;
          }
        }
        syncCopilotScopeControls();
      });
    });

    syncCopilotScopeControls();

    document.querySelectorAll(".quick-prompt-btn").forEach(function(btn) {
      btn.addEventListener("click", function() {
        if (messageInput && chatForm) {
          messageInput.value = btn.getAttribute("data-prompt");
          chatForm.requestSubmit();
        }
      });
    });

    document.querySelectorAll("[data-day-edit-open]").forEach(function(btn) {
      btn.addEventListener("click", function() {
        const card = btn.closest(".day-card");
        if (!card) return;
        const readView = card.querySelector("[data-day-read-view]");
        const editView = card.querySelector("[data-day-edit-view]");
        if (readView && editView) {
          readView.hidden = true;
          editView.hidden = false;
          btn.hidden = true;
          btn.setAttribute("aria-expanded", "true");
        }
      });
    });

    document.querySelectorAll("[data-day-edit-cancel]").forEach(function(btn) {
      btn.addEventListener("click", function() {
        const card = btn.closest(".day-card");
        if (!card) return;
        const readView = card.querySelector("[data-day-read-view]");
        const editView = card.querySelector("[data-day-edit-view]");
        const openBtn = card.querySelector("[data-day-edit-open]");
        if (readView && editView) {
          readView.hidden = false;
          editView.hidden = true;
          if (openBtn) {
            openBtn.hidden = false;
            openBtn.setAttribute("aria-expanded", "false");
          }
        }
      });
    });

    if (chatForm && sendBtn) {
      chatForm.addEventListener("submit", function() {
        sendBtn.value = "<%= j t('ai_chat_sessions.sending_button') %>";
      });
    }
  })();
</script>
<% end %>
