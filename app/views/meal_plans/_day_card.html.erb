<% is_today = (day == today_key) %>
<div class="card day-card <%= 'day-card-today' if is_today %> <%= 'day-card-detailed' if detailed %>">
  <div class="day-header">
    <div class="day-header-title-group">
      <span><%= t("days_of_week.#{day.downcase}") %></span>
      <% if is_today %>
        <span class="today-badge"><%= t('meal_plans.index.today_badge') %></span>
      <% elsif view_mode == "week" %>
        <span class="day-header-icon">🗓️</span>
      <% end %>
    </div>

    <% if authenticated? && view_mode == "day" %>
      <button type="button"
              class="day-edit-toggle-btn"
              data-day-edit-open
              aria-expanded="false">
        <%= t('meal_plans.index.edit_day') %>
      </button>
    <% end %>
  </div>

  <% if authenticated? && view_mode == "week" %>
    <div class="meal-slot" style="margin-bottom: 0.8rem;">
      <span class="meal-label"><%= t('meal_plans.index.lunch') %></span>
      <%= select_tag "days[#{day}][lunch_dish_id]",
                     options_from_collection_for_select(@dishes, :id, :name, plan.lunch_dish_id),
                     include_blank: t('meal_plans.index.none'),
                     class: "meal-dish-selector week-dish-selector" %>
    </div>

    <div class="meal-slot" style="margin-bottom: 0;">
      <span class="meal-label"><%= t('meal_plans.index.dinner') %></span>
      <%= select_tag "days[#{day}][dinner_dish_id]",
                     options_from_collection_for_select(@dishes, :id, :name, plan.dinner_dish_id),
                     include_blank: t('meal_plans.index.none'),
                     class: "meal-dish-selector week-dish-selector" %>
    </div>
  <% else %>
    <div data-day-read-view>
      <%= render "meal_plans/readonly_meal_slot",
                 label: t('meal_plans.index.lunch'),
                 dish: plan.lunch_dish,
                 detailed: detailed,
                 last_slot: false %>
      <%= render "meal_plans/readonly_meal_slot",
                 label: t('meal_plans.index.dinner'),
                 dish: plan.dinner_dish,
                 detailed: detailed,
                 last_slot: true %>
    </div>

    <% if authenticated? && view_mode == "day" %>
      <div class="day-inline-edit-form" data-day-edit-view hidden>
        <%= form_with url: update_day_meal_plans_path, method: :patch, local: true do |f| %>
          <%= f.hidden_field :day_of_week, value: day %>
          <%= hidden_field_tag :view, view_mode %>
          <%= hidden_field_tag :day, day %>

          <div class="meal-slot" style="margin-bottom: 0.8rem;">
            <span class="meal-label"><%= t('meal_plans.index.lunch') %></span>
            <%= f.select :lunch_dish_id,
                         options_from_collection_for_select(@dishes, :id, :name, plan.lunch_dish_id),
                         { include_blank: t('meal_plans.index.none') },
                         { class: "meal-dish-selector" } %>
          </div>

          <div class="meal-slot" style="margin-bottom: 1rem;">
            <span class="meal-label"><%= t('meal_plans.index.dinner') %></span>
            <%= f.select :dinner_dish_id,
                         options_from_collection_for_select(@dishes, :id, :name, plan.dinner_dish_id),
                         { include_blank: t('meal_plans.index.none') },
                         { class: "meal-dish-selector" } %>
          </div>

          <div class="day-edit-actions">
            <%= f.submit t('meal_plans.index.update_day'), class: "update-day-btn" %>
            <button type="button" class="btn-secondary day-edit-cancel-btn" data-day-edit-cancel>
              <%= t('meal_plans.index.cancel_edit') %>
            </button>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
