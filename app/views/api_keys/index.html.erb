<div class="header-actions">
  <h2 class="section-title"><%= t('api_keys.index.title') %></h2>
  <button type="button" class="btn-action" id="btn-open-generate-modal">
    + <%= t('api_keys.index.create_key') %>
  </button>
</div>

<div class="card" style="padding: 1.5rem;">
  <h3 style="font-family: var(--font-family-title); margin-bottom: 1.5rem; color: var(--color-secondary);">
    <%= t('api_keys.index.keys_title') %>
  </h3>

  <% if @api_keys.empty? %>
    <div class="empty-state">
      <%= t('api_keys.index.no_keys') %>
    </div>
  <% else %>
    <div id="keys-table-container">
      <table class="table-card" id="api-keys-table">
        <thead>
          <tr>
            <th><%= t('api_keys.index.name_label') %></th>
            <th>Llave (Enmascarada)</th>
            <th><%= t('api_keys.index.status') %></th>
            <th><%= t('api_keys.index.last_used') %></th>
            <th style="text-align: right;"><%= t('api_keys.index.actions') %></th>
          </tr>
        </thead>
        <tbody id="api-keys-list">
          <% @api_keys.each do |key| %>
            <tr id="key-row-<%= key.id %>">
              <td style="font-weight: 700; color: var(--color-secondary);"><%= key.name %></td>
              <td style="font-family: monospace;">dmeal_live_...<%= key.token_digest[-4..-1] || "" %></td>
              <td>
                <% if key.active %>
                  <span class="status-badge status-active"><%= t('api_keys.index.active') %></span>
                <% else %>
                  <span class="status-badge status-inactive"><%= t('api_keys.index.inactive') %></span>
                <% end %>
              </td>
              <td style="font-size: 0.85rem; color: var(--color-subtitle);">
                <%= key.last_used_at.present? ? l(key.last_used_at, format: :short) : t('meal_plans.index.none') %>
              </td>
              <td style="text-align: right;">
                <div style="display: inline-flex; align-items: center; justify-content: flex-end; gap: 0.5rem;">
                  <%= button_to key.active ? t('api_keys.index.deactivate_key') : t('api_keys.index.activate_key'),
                                api_key_path(key),
                                method: :patch,
                                params: { api_key: { active: !key.active } },
                                class: "btn-secondary",
                                style: "font-size: 0.8rem; padding: 0.45rem 0.9rem;" %>
                  
                  <%= button_to t('api_keys.index.revoke_key'),
                                api_key_path(key),
                                method: :delete,
                                data: { confirm: t('dishes.index.actions.confirm_delete') },
                                class: "btn-danger",
                                style: "font-size: 0.8rem; padding: 0.45rem 0.9rem;" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>

<!-- Modal Overlay for API Key Generation -->
<div class="modal-overlay" id="generate-modal" style="<%= flash[:plain_token].present? ? 'display: flex;' : 'display: none;' %>">
  <div class="modal-card">
    <button type="button" class="btn-close-modal" id="btn-close-modal-top" style="position: absolute; top: 1.25rem; right: 1.25rem; background: none; border: none; font-size: 1.2rem; cursor: pointer;">✕</button>
    
    <!-- Success Content Screen (Shown when key has been generated successfully) -->
    <% if flash[:plain_token].present? %>
      <div id="modal-success-content">
        <h3 style="font-family: var(--font-family-title); margin-bottom: 1.2rem; color: var(--color-secondary); display: flex; align-items: center; gap: 0.5rem;">
          <span>✅</span> <%= t('api_keys.controller.created') %>
        </h3>
        <p style="font-size: 0.85rem; color: var(--color-subtitle); margin-bottom: 1rem;">
          <%= t('api_keys.index.copy_warning') %>
        </p>
        
        <div class="token-display-box">
          <span id="generated-token-text" style="font-weight: 700;"><%= flash[:plain_token] %></span>
          <button class="btn-copy" id="btn-copy-token" type="button"><%= t('meal_plans.index.copy_clipboard') %></button>
        </div>

        <div style="display: flex; justify-content: flex-end; margin-top: 1.5rem;">
          <button type="button" class="btn-primary btn-close-modal" style="background: var(--color-primary); color: var(--color-secondary); border: none; padding: 0.65rem 1.25rem; border-radius: 8px; font-weight: bold; cursor: pointer;">
            Entendido
          </button>
        </div>
      </div>
    <% else %>
      <!-- Form Content Screen (Shown when opening form to create a key) -->
      <div id="modal-form-content">
        <h3 style="font-family: var(--font-family-title); margin-bottom: 1.2rem; color: var(--color-secondary);">
          <%= t('api_keys.index.generate_title') %>
        </h3>
        
        <%= form_with model: @api_key, local: true do |f| %>
          <div class="form-group">
            <%= f.label :name, t('api_keys.index.name_label'), class: "form-label" %>
            <%= f.text_field :name, class: "form-input", placeholder: t('api_keys.index.name_placeholder'), required: true %>
          </div>
          
          <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 1.5rem;">
            <button type="button" class="btn-secondary btn-close-modal" style="padding: 0.65rem 1.25rem;">Cancelar</button>
            <%= f.submit t('api_keys.index.create_key'), class: "btn-action", style: "width: auto; padding: 0.65rem 1.25rem;" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener("turbo:load", function() {
    const modal = document.getElementById("generate-modal");
    const btnOpen = document.getElementById("btn-open-generate-modal");
    const btnsClose = document.querySelectorAll(".btn-close-modal");
    
    const btnCopy = document.getElementById("btn-copy-token");
    const tokenText = document.getElementById("generated-token-text");

    // Open modal to generate a new key
    if (btnOpen && modal) {
      btnOpen.addEventListener("click", function() {
        modal.style.display = "flex";
        // Reset inputs if form is rendered inside modal
        const nameInput = document.getElementById("api_key_name");
        if (nameInput) nameInput.value = "";
      });
    }

    // Close modal function
    function closeModal() {
      if (modal) {
        modal.style.display = "none";
        // If success message was shown, reloading cleans the flash token so it cannot be recovered
        if (document.getElementById("modal-success-content")) {
          window.location.reload();
        }
      }
    }

    btnsClose.forEach(btn => {
      btn.addEventListener("click", function(e) {
        e.preventDefault();
        closeModal();
      });
    });

    // Copy to clipboard functionality
    if (btnCopy && tokenText) {
      btnCopy.addEventListener("click", function() {
        navigator.clipboard.writeText(tokenText.innerText).then(() => {
          btnCopy.innerText = "<%= j t('meal_plans.index.copied') %>";
          setTimeout(() => {
            btnCopy.innerText = "<%= j t('meal_plans.index.copy_clipboard') %>";
          }, 2000);
        });
      });
    }
  });
</script>
