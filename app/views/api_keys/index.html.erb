<h2 class="section-title"><%= t('api_keys.index.title') %></h2>

<div class="dashboard-grid">
  <!-- Left Column: Active Keys List -->
  <div class="card" style="padding: 1.5rem;">
    <h3 style="font-family: var(--font-family-title); margin-bottom: 1.5rem; color: var(--color-secondary);">
      <%= t('api_keys.index.keys_title') %>
    </h3>

    <% if @api_keys.empty? %>
      <div class="empty-state">
        <%= t('api_keys.index.no_keys') %>
      </div>
    <% else %>
      <div id="keys-table-container">
        <table class="table-card" id="api-keys-table">
          <thead>
            <tr>
              <th><%= t('api_keys.index.name_label') %></th>
              <th>Llave (Enmascarada)</th>
              <th><%= t('api_keys.index.status') %></th>
              <th><%= t('api_keys.index.last_used') %></th>
              <th style="text-align: right;"><%= t('api_keys.index.actions') %></th>
            </tr>
          </thead>
          <tbody id="api-keys-list">
            <% @api_keys.each do |key| %>
              <tr id="key-row-<%= key.id %>">
                <td style="font-weight: 700; color: var(--color-secondary);"><%= key.name %></td>
                <td style="font-family: monospace;">dmeal_live_...<%= key.token_digest[-4..-1] || "" %></td>
                <td>
                  <% if key.active %>
                    <span class="status-badge status-active"><%= t('api_keys.index.active') %></span>
                  <% else %>
                    <span class="status-badge status-inactive"><%= t('api_keys.index.inactive') %></span>
                  <% end %>
                </td>
                <td style="font-size: 0.85rem; color: var(--color-subtitle);">
                  <%= key.last_used_at.present? ? l(key.last_used_at, format: :short) : t('meal_plans.index.none') %>
                </td>
                <td style="text-align: right;">
                  <div style="display: inline-flex; align-items: center; justify-content: flex-end; gap: 0.5rem;">
                    <%= button_to key.active ? t('api_keys.index.deactivate_key') : t('api_keys.index.activate_key'),
                                  api_key_path(key),
                                  method: :patch,
                                  params: { api_key: { active: !key.active } },
                                  class: "btn-secondary",
                                  style: "font-size: 0.8rem; padding: 0.45rem 0.9rem;" %>
                    
                    <%= button_to t('api_keys.index.revoke_key'),
                                  api_key_path(key),
                                  method: :delete,
                                  data: { confirm: t('dishes.index.actions.confirm_delete') },
                                  class: "btn-danger",
                                  style: "font-size: 0.8rem; padding: 0.45rem 0.9rem;" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <!-- Right Column: Generation Panel -->
  <div class="card">
    <h3 style="font-family: var(--font-family-title); margin-bottom: 1.5rem; color: var(--color-secondary);">
      <%= t('api_keys.index.generate_title') %>
    </h3>

    <% if @api_key.errors.any? %>
      <div class="flash flash-alert" style="margin-bottom: 1.5rem;">
        <h4 style="margin-bottom: 0.5rem;"><%= t('api_keys.form.errors_title') %></h4>
        <ul>
          <% @api_key.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Success Message with Token (Shown once immediately after generation) -->
    <% if flash[:plain_token].present? %>
      <div class="alert alert-success" style="margin-bottom: 1.5rem;">
        <p><%= t('api_keys.index.copy_warning') %></p>
        <div class="token-display-box" style="margin-top: 0.75rem;">
          <span id="generated-token-text" style="font-weight: 700;"><%= flash[:plain_token] %></span>
          <button class="btn-copy" id="btn-copy-token" type="button"><%= t('meal_plans.index.copy_clipboard') %></button>
        </div>
      </div>
    <% end %>

    <%= form_with model: @api_key, local: true do |f| %>
      <div class="form-group">
        <%= f.label :name, t('api_keys.index.name_label'), class: "form-label" %>
        <%= f.text_field :name, class: "form-input", placeholder: t('api_keys.index.name_placeholder'), required: true %>
      </div>
      <%= f.submit t('api_keys.index.create_key'), class: "btn-action" %>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener("turbo:load", function() {
    const btnCopy = document.getElementById("btn-copy-token");
    const tokenText = document.getElementById("generated-token-text");

    if (btnCopy && tokenText) {
      btnCopy.addEventListener("click", function() {
        navigator.clipboard.writeText(tokenText.innerText).then(() => {
          btnCopy.innerText = "<%= j t('meal_plans.index.copied') %>";
          setTimeout(() => {
            btnCopy.innerText = "<%= j t('meal_plans.index.copy_clipboard') %>";
          }, 2000);
        });
      });
    }
  });
</script>
