# DailyMeals Environment Configuration Template
# Copy this file to .env for local development. Never commit real secrets to Git.

# Master password required to log in to the DailyMeals web interface (Single-Owner Access Control)
APP_ACCESS_PASSWORD=change-me-to-a-strong-password

# Google Gemini API credentials for the AI Copilot Pseudo-Chat
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
