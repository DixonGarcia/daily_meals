# DailyMeals Production Environment Template (Hetzner VPS)
# Copy to .env.production on the VPS (never commit .env.production to Git).
# deploy/hetzner-bootstrap.sh generates this file with strong random secrets automatically.

# ---------------------------------------------------------------------------
# 1. Domain & TLS (Caddy + Rails SSL)
# ---------------------------------------------------------------------------
# Option A (IP-only initial setup, no domain yet):
SITE_ADDRESS=:80
FORCE_SSL=false

# Option B (Domain pointed to your Hetzner VPS IPv4 for automatic Let's Encrypt HTTPS):
# SITE_ADDRESS=yourdomain.com
# FORCE_SSL=true

# Subpath where DailyMeals is mounted (leave blank if serving at root /)
RAILS_RELATIVE_URL_ROOT=/daily_meals

# ---------------------------------------------------------------------------
# 2. PostgreSQL (used by both the `db` container and Rails `web` container)
# ---------------------------------------------------------------------------
POSTGRES_USER=daily_meals
POSTGRES_PASSWORD=replace-with-strong-random-password
POSTGRES_DB=daily_meals_production
DATABASE_URL=postgres://daily_meals:replace-with-strong-random-password@db:5432/daily_meals_production

# ---------------------------------------------------------------------------
# 3. Rails & Application Secrets
# ---------------------------------------------------------------------------
RAILS_ENV=production
RAILS_LOG_LEVEL=info
# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=replace-with-openssl-rand-hex-64

# Master password for single-owner web login (/session/new)
APP_ACCESS_PASSWORD=replace-with-your-strong-master-password

# Google Gemini API credentials for AI Copilot & Dish Autocomplete
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.1-flash-lite
